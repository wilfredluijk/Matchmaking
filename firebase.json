{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.md"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/admin", "destination": "/live/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
